# Base image: every dependency aegis_gym needs, but not aegis_gym itself.
# Derived by run/Containerfile.prod and dev/Containerfile.toolbx.
#
# Build context must be container/, so that scripts/ is reachable below.

ARG TORCH_REF=ceai/aegis_gym_torch:latest

FROM ${TORCH_REF} AS simulation

ARG AEGIS_GYM_TAG=devel
ARG CEAI_RSL_RL_TAG=v3.3.2
# Cache buster: changes whenever the branch points at a new commit.
ARG AEGIS_GYM_REV=unknown

USER root
WORKDIR /ws

ENV DEBIAN_FRONTEND=noninteractive
ENV UV_SYSTEM_PYTHON=1

COPY scripts/install_simulation.sh /tmp/install_simulation.sh

# The echo puts AEGIS_GYM_REV into this layer's cache key, so the dependency
# install is redone when the branch moves even though the tag is unchanged.
RUN echo ">>> aegis_gym @ ${AEGIS_GYM_REV}" \
    && CEAI_RSL_RL_TAG="${CEAI_RSL_RL_TAG}" \
        AEGIS_GYM_TAG="${AEGIS_GYM_TAG}" \
        bash /tmp/install_simulation.sh \
    && rm -f /tmp/install_simulation.sh

ENV PYOPENGL_PLATFORM=egl
ENV PYGLET_HEADLESS=1

CMD ["/bin/bash"]

FROM simulation AS hardware_control

ARG AEGIS_ROS_TAG=humble-devel
ARG AEGIS_ROS_REV=unknown

COPY scripts/install_hardware_control.sh /tmp/install_hardware_control.sh

RUN echo ">>> aegis_ros @ ${AEGIS_ROS_REV}" \
    && AEGIS_ROS_TAG="${AEGIS_ROS_TAG}" \
        bash /tmp/install_hardware_control.sh \
    && rm -f /tmp/install_hardware_control.sh

# Declared last on purpose: BUILD_DATE changes on every build and would
# invalidate the cache of everything after it.
ARG TORCH_REF
ARG AEGIS_GYM_TAG
ARG AEGIS_GYM_REV
ARG CEAI_RSL_RL_TAG
ARG BUILD_DATE=unknown

LABEL org.opencontainers.image.authors="ceai@agh.edu.pl"
LABEL org.opencontainers.image.source="https://github.com/AGH-CEAI/aegis_gym"
LABEL org.opencontainers.image.created=${BUILD_DATE}
LABEL aegis.image.type="base"
LABEL aegis.base.ref=${TORCH_REF}
LABEL aegis.gym.tag=${AEGIS_GYM_TAG}
LABEL aegis.gym.rev=${AEGIS_GYM_REV}
LABEL aegis.ros.tag=${AEGIS_ROS_TAG}
LABEL ceai.rsl_rl.tag=${CEAI_RSL_RL_TAG}
LABEL aegis.build.date=${BUILD_DATE}

CMD ["/bin/bash"]
